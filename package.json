{
  "name": "pi-perimeter",
  "version": "0.0.0",
  "description": "Planned workspace-first security extension for Pi (formerly pi-warden)",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-perimeter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-warden/pi-warden.git"
  },
  "homepage": "https://github.com/pi-warden/pi-warden#readme",
  "bugs": {
    "url": "https://github.com/pi-warden/pi-warden/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --import ./test/canonical-tmpdir.mjs --test test/*.test.ts",
    "test:paths": "node --import ./test/canonical-tmpdir.mjs --test test/paths.test.ts",
    "test:configuration": "node --import ./test/canonical-tmpdir.mjs --test test/configuration.test.ts",
    "test:approvals": "node --import ./test/canonical-tmpdir.mjs --test test/approvals.test.ts",
    "test:controlled": "node --import ./test/canonical-tmpdir.mjs --test test/controlled-traversal.test.ts",
    "test:gate": "node --import ./test/canonical-tmpdir.mjs --test test/gate-runtime.test.ts",
    "test:package": "node --import ./test/canonical-tmpdir.mjs --test test/package-lifecycle.test.ts",
    "test:manifest": "node --import ./test/canonical-tmpdir.mjs --test test/hash-manifest.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "build:native": "node scripts/build-native.mjs",
    "test:shell": "node --import ./test/canonical-tmpdir.mjs --test test/shell-grammar.test.ts test/shell-plan.test.ts test/shell-policy.test.ts test/shell-approvals.test.ts test/seatbelt-profile.test.ts",
    "test:sandbox": "node --import ./test/canonical-tmpdir.mjs --test test/projection.test.ts test/export.test.ts test/quiescence.test.ts",
    "test:containment": "node --import ./test/canonical-tmpdir.mjs --test --test-timeout=180000 test/shell-containment.test.ts"
  },
  "files": [
    "src",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
